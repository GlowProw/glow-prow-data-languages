  "impetusOrder": {
    "name": "Impetus Order",
    "description": [
      "You can now gain stacks of Impetus.",
      "When at 5 stacks of Impetus, consume 5 stacks to increase Turn Speed, Acceleration and Top Speed by 5% for 30s.",
      "When another Order Perk is activated, this buff no longer consumes Impetus and is applied permanently."
    ]
  },
  "batteringForce": {
    "name": "Battering Force",
    "description": [
      "Generate 5 stacks of Impetus (Max 10) upon Ramming or performing a Crew Attack.",
      "Generating Impetus increases Weapon Damage and Repair Amount by 50% for 10s."
    ]
  },
  "relentlessForce": {
    "name": "Relentless Force",
    "description": [
      "Generate 1 stack of Impetus (Max 10) for every 8 weapon hits on enemies. Demicannons require 4 times as many hits.",
      "Generating Impetus increases Weapon Damage and Repair Amount by 15% for 5s."
    ]
  },
  "unstoppableForce": {
    "name": "Unstoppable Force",
    "description": [
      "Generate 1 stack of Impetus (Max 10) for every 110m travelled.",
      "Generating Impetus increases Weapon Damage and Repair Amount by 3% for every knot of speed above 10 knots, for 5s."
    ]
  },
  "heavyBombardment": {
    "name": "Heavy Bombardment",
    "description": [
      "Generating Impetus increases the radius of all weapon Area-of-Effects by 5m for 10s (Max 5 stacks).",
      "At max stacks, Secondary Damage for all weapons is increased by 20%."
    ]
  },
  "weaknessFinder": {
    "name": "Weakness Finder",
    "description": [
      "Generating Impetus adds a 20% chance to convert any weapon shot into a weakpoint hit for 5s."
    ]
  },
  "rejuvenation": {
    "name": "Rejuvenation",
    "description": [
      "Generating Impetus restores 3% of max HP."
    ]
  },
  "stormblazeOrder": {
    "name": "Stormblaze Order",
    "description": [
      "When at 10 stacks of Impetus, the next weapon hit consumes 10 stacks and triggers an AoE burst on the target that deals 150% of your max. Hull Health as Burning & Lightning damage to all enemies within 250m.",
      "This effect can also be triggered by Ramming without it consuming Impetus."
    ]
  },
  "firepowerOrder": {
    "name": "Firepower Order",
    "description": [
      "When at 10 stacks of Impetus, fire an Auxiliary weapon to consume 10 stacks and convert all weapon hits to weakpoint hits for 8s."
    ]
  },
  "mendingOrder": {
    "name": "Mending Order",
    "description": [
      "When at 5 stacks of Impetus, brace for 2s and release to consume 5 stacks and release an AoE heal that heals you for 30% of your max. Hull Health as well as all allies within 350m.",
      "This effect also triggers automatically when below 50% max. Hull Health or on death."
    ]
  },
  "fireAndSteel": {
    "name": "Fire And Steel",
    "description": [
      "Generate 1 stack of Impetus by applying any elemental status effect on a target.",
      "This effect can only trigger once every 5s."
    ]
  },
  "vitalStrike": {
    "name": "Vital Strike",
    "description": [
      "Generate 1 stack of Impetus by destroying a weakpoint.",
      "This effect can only trigger once every 5s."
    ]
  },
  "killingDrive": {
    "name": "Killing Drive",
    "description": [
      "Generate 1 stack of Impetus by destroying a target.",
      "This effect can only trigger once every 5s."
    ]
  },
  "hardenedMomentum": {
    "name": "Hardened Momentum",
    "description": [
      "While at or above 5 stacks of Impetus, increase Armor Multiplier by 5%."
    ]
  },
  "adaptiveArsenal": {
    "name": "Adaptive Arsenal",
    "description": [
      "Increases Weapon Damage by 5% for each different weapon type equipped"
    ]
  },
  "enduringBrace": {
    "name": "Enduring Brace",
    "description": [
      "Increase Brace Strength Recovery by 0.01% per 1000 points of Maximum Health."
    ]
  },
  "volatileArsenal": {
    "name": "Volatile Arsenal",
    "description": [
      "Increases elemental damage by 5% for each Weapon element equipped.",
      "Includes Elements gained from Weapon modifications"
    ]
  },
  "loadedOdds": {
    "name": "Loaded Odds",
    "description": [
      "Adds a chance of 10% to generate an additional stack of Impetus whenever an Impetus stack is generated."
    ]
  },
  "fortifiedHull": {
    "name": "Fortified Hull",
    "description": [
      "For every 2000 points of Brace Strength, increase incoming Repair Amount by 1% (max 10%)."
    ]
  },
  "revitalizedFury": {
    "name": "Revitalized Fury",
    "description": [
      "Increases Weapon Damage and Repair Amount by 15% for 5s when receiving a heal of 3% of your Maximum Health or greater."
    ]
  },
  "careAndCarnage": {
    "name": "Care And Carnage",
    "description": [
      "For every 10% increases of Repair per Shot, increase Weapon Damage by 5% up to a maximum of 30%."
    ]
  },
  "battleTempo": {
    "name": "Battle Tempo",
    "description": [
      "Increases the maximum stacks of Impetus by 5."
